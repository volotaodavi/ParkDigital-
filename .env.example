# O frontend Next.js roda em localhost:3000 por padrão, então o backend
# usa outra porta em desenvolvimento local para não colidir.
PORT=4000

# Origem do frontend autorizada a chamar esta API (CORS)
CORS_ORIGIN=http://localhost:3000

# Credenciais do projeto Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=coloque_aqui_sua_service_role_key_ou_anon_key

# Regras de negócio da Zona Azul
PRECO_POR_MINUTO=0.10
PIX_CHAVE=contato@parkdigital.com.br

# Segredo usado para assinar/validar os tokens JWT do login
# (motorista/fiscal/gestor público). Use um valor longo e aleatório em produção.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio
JWT_EXPIRES_IN=8h
