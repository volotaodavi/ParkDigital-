# =============================================================================
# ParkDigital — Backend (Express/TypeScript)
# =============================================================================
# Este arquivo documenta TODAS as variáveis de ambiente do ecossistema e em
# qual painel cada uma é configurada em produção:
#   [RENDER]   -> serviços "parkdigital-backend" (web) e
#                 "parkdigital-cron-alertas" (worker), ver render.yaml
#   [SUPABASE] -> Project Settings > API, no painel do projeto
#   [VERCEL]   -> projeto do frontend Next.js (parkdigital-frontend)
#
# NUNCA commite um arquivo .env real com valores verdadeiros. Este .env.example
# é seguro de versionar porque só contém placeholders.
# =============================================================================

# ---- Servidor -----------------------------------------------------------
# [RENDER] Definida automaticamente pela plataforma; em dev local, o
# frontend Next.js ocupa a porta 3000, então o backend usa outra.
PORT=4000

# [RENDER] Origem do frontend autorizada a chamar esta API (CORS). Em
# produção, é a URL pública do projeto no Vercel (ex: https://parkdigital.vercel.app).
CORS_ORIGIN=http://localhost:3000

# ---- Supabase -------------------------------------------------------------
# [SUPABASE] Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# [SUPABASE] Project Settings > API > service_role key (nunca a chave anon
# em rotas que escrevem no banco). Trate como segredo: acesso total ao banco.
SUPABASE_KEY=coloque_aqui_sua_service_role_key

# ---- Regras de negócio da Zona Azul ----------------------------------------
# [RENDER] Valor cobrado por minuto de vaga, usado para calcular o Pix.
PRECO_POR_MINUTO=0.10

# [RENDER] Chave Pix (CNPJ/e-mail) da prefeitura/operadora que recebe os
# pagamentos simulados pelo gateway.
PIX_CHAVE=contato@parkdigital.com.br

# ---- Autenticação (JWT) ----------------------------------------------------
# [RENDER] Segredo usado para assinar/validar os tokens JWT do login
# (motorista/fiscal/gestor público). Gere um valor longo e aleatório por
# ambiente (ex: `openssl rand -base64 48`) — nunca reaproveite entre
# ambientes de teste e produção. No render.yaml este valor é gerado
# automaticamente pela plataforma (generateValue) e compartilhado entre os
# serviços web e worker via envVarGroup.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# [RENDER] Validade do token emitido pelo login.
JWT_EXPIRES_IN=8h

# =============================================================================
# Variáveis do frontend (configuradas no painel do projeto na Vercel, não
# aqui — ver parkdigital-frontend/.env.local.example para a lista completa
# usada em desenvolvimento local)
# =============================================================================
# [VERCEL] NEXT_PUBLIC_API_URL: URL pública do serviço "parkdigital-backend"
# no Render (ex: https://parkdigital-backend.onrender.com). Como começa com
# NEXT_PUBLIC_, fica exposta no navegador — nunca coloque segredos nela.
